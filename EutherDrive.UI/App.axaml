<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EutherDrive.UI.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <Color x:Key="EdBg">#091119</Color>
        <Color x:Key="EdBgSoft">#0F1923</Color>
        <Color x:Key="EdPanel">#121C27</Color>
        <Color x:Key="EdPanelRaised">#172433</Color>
        <Color x:Key="EdPanelGlass">#CC162330</Color>
        <Color x:Key="EdStroke">#324356</Color>
        <Color x:Key="EdStrokeBright">#4E6B86</Color>
        <Color x:Key="EdText">#EEF6FF</Color>
        <Color x:Key="EdTextMuted">#91A8BD</Color>
        <Color x:Key="EdAccent">#5EEAD4</Color>
        <Color x:Key="EdAccentWarm">#F59E0B</Color>
        <Color x:Key="EdAccentHot">#FB7185</Color>

        <SolidColorBrush x:Key="EdBgBrush" Color="{DynamicResource EdBg}" />
        <SolidColorBrush x:Key="EdBgSoftBrush" Color="{DynamicResource EdBgSoft}" />
        <SolidColorBrush x:Key="EdPanelBrush" Color="{DynamicResource EdPanel}" />
        <SolidColorBrush x:Key="EdPanelRaisedBrush" Color="{DynamicResource EdPanelRaised}" />
        <SolidColorBrush x:Key="EdPanelGlassBrush" Color="{DynamicResource EdPanelGlass}" />
        <SolidColorBrush x:Key="EdStrokeBrush" Color="{DynamicResource EdStroke}" />
        <SolidColorBrush x:Key="EdStrokeBrightBrush" Color="{DynamicResource EdStrokeBright}" />
        <SolidColorBrush x:Key="EdTextBrush" Color="{DynamicResource EdText}" />
        <SolidColorBrush x:Key="EdTextMutedBrush" Color="{DynamicResource EdTextMuted}" />
        <SolidColorBrush x:Key="EdAccentBrush" Color="{DynamicResource EdAccent}" />
        <SolidColorBrush x:Key="EdAccentWarmBrush" Color="{DynamicResource EdAccentWarm}" />
        <SolidColorBrush x:Key="EdAccentHotBrush" Color="{DynamicResource EdAccentHot}" />

        <Color x:Key="EdButtonBg">#172433</Color>
        <Color x:Key="EdButtonBgHover">#1D3143</Color>
        <Color x:Key="EdButtonBgPressed">#12202C</Color>
        <Color x:Key="EdButtonActionBg">#163B41</Color>
        <Color x:Key="EdButtonActionBgHover">#1A4B53</Color>
        <Color x:Key="EdButtonGhostBg">#22131D</Color>
        <Color x:Key="EdButtonBorder">#324356</Color>
        <Color x:Key="EdButtonBorderHover">#5EEAD4</Color>
        <Color x:Key="EdButtonGhostBorder">#6E4758</Color>
        <Color x:Key="EdToggleBg">#14202C</Color>
        <Color x:Key="EdToggleCheckedBg">#1D454C</Color>
        <Color x:Key="EdSubPanelBg">#B8142230</Color>
        <Color x:Key="EdSubPanelBorder">#35506A</Color>
        <Color x:Key="EdOptionCardBg">#D0132030</Color>
        <Color x:Key="EdOptionCardBorder">#304355</Color>
        <Color x:Key="EdInputBg">#101B26</Color>
        <Color x:Key="EdInputBgFocus">#0E1822</Color>
        <Color x:Key="EdInputBorder">#324356</Color>
        <Color x:Key="EdInputBorderFocus">#5EEAD4</Color>
        <Color x:Key="EdBgFx1">#182A3D</Color>
        <Color x:Key="EdBgFx2">#2A1B24</Color>
        <CornerRadius x:Key="EdCornerSmall">10</CornerRadius>
        <CornerRadius x:Key="EdCornerMedium">12</CornerRadius>
        <CornerRadius x:Key="EdCornerLarge">18</CornerRadius>
        <CornerRadius x:Key="EdCornerXLarge">22</CornerRadius>
        <CornerRadius x:Key="EdCornerFull">999</CornerRadius>
        <CornerRadius x:Key="EdPanelCornerRadius">18</CornerRadius>
        <CornerRadius x:Key="EdSubPanelCornerRadius">14</CornerRadius>
        <CornerRadius x:Key="EdOptionCardCornerRadius">12</CornerRadius>
        <CornerRadius x:Key="EdButtonCornerRadius">12</CornerRadius>
        <CornerRadius x:Key="EdInputCornerRadius">12</CornerRadius>
        <Thickness x:Key="EdButtonPadding">12,8</Thickness>
        <Thickness x:Key="EdButtonCompactPadding">10,6</Thickness>
        <Thickness x:Key="EdButtonSmallPadding">8,4</Thickness>
        <Thickness x:Key="EdInputPadding">8,6</Thickness>
        <x:Double x:Key="EdDeckLabelSize">14</x:Double>
        <x:Double x:Key="EdDeckLabelSpacing">1.1</x:Double>
        <x:Double x:Key="EdKickerSize">11</x:Double>
        <x:Double x:Key="EdDisplaySize">28</x:Double>
        <x:Double x:Key="EdBgFxOpacity">0.18</x:Double>
        <x:Double x:Key="EdScreenGlowOpacity">0.28</x:Double>
        <FontFamily x:Key="EdPrimaryFont">Inter</FontFamily>
        <FontFamily x:Key="EdDisplayFont">Inter</FontFamily>
        <FontFamily x:Key="EdDeckLabelFont">Noto Sans, Inter</FontFamily>
        <FontFamily x:Key="EdMonoFont">JetBrains Mono, Consolas, Menlo, monospace</FontFamily>
        <Color x:Key="EdScreenShellBg">#081018</Color>
        <Color x:Key="EdLogPanelBg">#171B25</Color>
        <Color x:Key="EdLogPanelBorder">#2E3A5A</Color>
        <Color x:Key="EdLogPanelAccentBg">#1A2B1E</Color>
        <Color x:Key="EdLogPanelAccentBorder">#2E5A3A</Color>
        <Color x:Key="EdLogPanelText">#DCE7FF</Color>
        <Color x:Key="EdLogPanelAccentText">#BFE9C8</Color>

        <SolidColorBrush x:Key="EdBgFx1Brush" Color="{DynamicResource EdBgFx1}" />
        <SolidColorBrush x:Key="EdBgFx2Brush" Color="{DynamicResource EdBgFx2}" />
        <SolidColorBrush x:Key="EdScreenShellBrush" Color="{DynamicResource EdScreenShellBg}" />
        <SolidColorBrush x:Key="EdLogPanelBrush" Color="{DynamicResource EdLogPanelBg}" />
        <SolidColorBrush x:Key="EdLogPanelBorderBrush" Color="{DynamicResource EdLogPanelBorder}" />
        <SolidColorBrush x:Key="EdLogPanelAccentBrush" Color="{DynamicResource EdLogPanelAccentBg}" />
        <SolidColorBrush x:Key="EdLogPanelAccentBorderBrush" Color="{DynamicResource EdLogPanelAccentBorder}" />
        <SolidColorBrush x:Key="EdLogPanelTextBrush" Color="{DynamicResource EdLogPanelText}" />
        <SolidColorBrush x:Key="EdLogPanelAccentTextBrush" Color="{DynamicResource EdLogPanelAccentText}" />

        <LinearGradientBrush x:Key="EdHeroBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#183249" Offset="0.0" />
            <GradientStop Color="#111F2D" Offset="0.42" />
            <GradientStop Color="#271A2A" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="EdScreenGlowBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#6626C6DA" Offset="0.0" />
            <GradientStop Color="#0026C6DA" Offset="0.7" />
            <GradientStop Color="#44F59E0B" Offset="1.0" />
        </LinearGradientBrush>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource EdBgBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource EdPrimaryFont}" />
            <Setter Property="Foreground" Value="{DynamicResource EdTextBrush}" />
        </Style>

        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource EdTextBrush}" />
        </Style>

        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource EdTextMutedBrush}" />
        </Style>

        <Style Selector="TextBlock.kicker">
            <Setter Property="Foreground" Value="{DynamicResource EdAccentBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource EdKickerSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.9" />
        </Style>

        <Style Selector="TextBlock.deck-label">
            <Setter Property="Foreground" Value="{DynamicResource EdAccentBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource EdDeckLabelFont}" />
            <Setter Property="FontSize" Value="{DynamicResource EdDeckLabelSize}" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="LetterSpacing" Value="{DynamicResource EdDeckLabelSpacing}" />
            <Setter Property="Opacity" Value="0.96" />
        </Style>

        <Style Selector="TextBlock.display">
            <Setter Property="FontSize" Value="{DynamicResource EdDisplaySize}" />
            <Setter Property="FontFamily" Value="{DynamicResource EdDisplayFont}" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="LetterSpacing" Value="0.4" />
        </Style>

        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{DynamicResource EdPanelGlassBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EdStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource EdPanelCornerRadius}" />
            <Setter Property="BoxShadow" Value="0 18 50 0 #44000000" />
        </Style>

        <Style Selector="Border.subpanel">
            <Setter Property="Background" Value="{DynamicResource EdSubPanelBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EdSubPanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource EdSubPanelCornerRadius}" />
        </Style>

        <Style Selector="Border.option-card">
            <Setter Property="Background" Value="{DynamicResource EdOptionCardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EdOptionCardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource EdOptionCardCornerRadius}" />
        </Style>

        <Style Selector="Border.hero">
            <Setter Property="Background" Value="{DynamicResource EdHeroBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EdStrokeBrightBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource EdCornerXLarge}" />
            <Setter Property="BoxShadow" Value="0 24 70 0 #66000000" />
        </Style>

        <Style Selector="Border.screen-shell">
            <Setter Property="Background" Value="{DynamicResource EdScreenShellBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EdStrokeBrightBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource EdCornerXLarge}" />
            <Setter Property="BoxShadow" Value="0 24 80 0 #77000000" />
        </Style>

        <Style Selector="Border.log-panel">
            <Setter Property="Background" Value="{DynamicResource EdLogPanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EdLogPanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource EdCornerSmall}" />
        </Style>

        <Style Selector="Border.log-panel-accent">
            <Setter Property="Background" Value="{DynamicResource EdLogPanelAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EdLogPanelAccentBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource EdCornerSmall}" />
        </Style>

        <Style Selector="Button">
            <Setter Property="Background" Value="{DynamicResource EdButtonBg}" />
            <Setter Property="Foreground" Value="{DynamicResource EdTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EdButtonBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource EdButtonCornerRadius}" />
            <Setter Property="Padding" Value="{DynamicResource EdButtonPadding}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.18"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="{DynamicResource EdButtonBgHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EdButtonBorderHover}" />
            <Setter Property="RenderTransform" Value="scale(1.025)" />
        </Style>

        <Style Selector="Button:pressed">
            <Setter Property="Background" Value="{DynamicResource EdButtonBgPressed}" />
            <Setter Property="RenderTransform" Value="scale(0.985)" />
        </Style>

        <Style Selector="Button.action">
            <Setter Property="Background" Value="{DynamicResource EdButtonActionBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EdAccentBrush}" />
        </Style>

        <Style Selector="Button.action:pointerover">
            <Setter Property="Background" Value="{DynamicResource EdButtonActionBgHover}" />
        </Style>

        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="{DynamicResource EdButtonGhostBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EdButtonGhostBorder}" />
        </Style>

        <Style Selector="Button.small">
            <Setter Property="Padding" Value="{DynamicResource EdButtonSmallPadding}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CornerRadius" Value="{DynamicResource EdCornerSmall}" />
        </Style>

        <Style Selector="Button.compact">
            <Setter Property="Padding" Value="{DynamicResource EdButtonCompactPadding}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style Selector="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource EdToggleBg}" />
            <Setter Property="Foreground" Value="{DynamicResource EdTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EdButtonBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource EdCornerFull}" />
            <Setter Property="Padding" Value="{DynamicResource EdButtonSmallPadding}" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.16"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.16"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="ToggleButton:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.04)" />
        </Style>

        <Style Selector="ToggleButton:checked">
            <Setter Property="Background" Value="{DynamicResource EdToggleCheckedBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EdAccentBrush}" />
        </Style>

        <Style Selector="ToggleButton.autofire">
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="{DynamicResource EdButtonSmallPadding}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource EdInputBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EdInputBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource EdInputCornerRadius}" />
            <Setter Property="Padding" Value="{DynamicResource EdInputPadding}" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource EdInputBgFocus}" />
            <Setter Property="Foreground" Value="{DynamicResource EdTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EdInputBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource EdInputCornerRadius}" />
            <Setter Property="Padding" Value="{DynamicResource EdInputPadding}" />
        </Style>

        <Style Selector="TextBox.log-view">
            <Setter Property="Background" Value="#00000000" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="{DynamicResource EdMonoFont}" />
            <Setter Property="Foreground" Value="{DynamicResource EdLogPanelTextBrush}" />
        </Style>

        <Style Selector="TextBox.status-inline">
            <Setter Property="Background" Value="#00000000" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="SelectionBrush" Value="{DynamicResource EdAccentBrush}" />
        </Style>

        <Style Selector="Separator">
            <Setter Property="Background" Value="#2A3847" />
            <Setter Property="Height" Value="1" />
            <Setter Property="Opacity" Value="0.65" />
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource EdTextBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="CheckBox /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource EdTextBrush}" />
        </Style>

        <Style Selector="CheckBox:disabled">
            <Setter Property="Foreground" Value="{DynamicResource EdTextMutedBrush}" />
            <Setter Property="Opacity" Value="0.85" />
        </Style>

        <Style Selector="CheckBox:disabled /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource EdTextMutedBrush}" />
        </Style>

        <Style Selector="CheckBox.option-check">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style Selector="CheckBox.option-check /template/ ContentPresenter">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource EdTextBrush}" />
        </Style>

        <Style Selector="Slider">
            <Setter Property="Background" Value="#00000000" />
        </Style>

        <Style Selector="ScrollViewer">
            <Setter Property="Background" Value="#00000000" />
        </Style>

        <Style Selector="Expander">
            <Setter Property="Foreground" Value="{DynamicResource EdTextBrush}" />
        </Style>
    </Application.Styles>
</Application>
