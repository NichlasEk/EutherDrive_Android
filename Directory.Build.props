<Project>
  <!-- Fixed-input performance experiments; absent from desktop/core builds. -->
  <PropertyGroup Condition="'$(N64PerformanceProbe)' == 'true'">
    <DefineConstants>$(DefineConstants);N64_PERF_PROBE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(N64CpuJitProfile)' == 'true'">
    <DefineConstants>$(DefineConstants);N64_CPU_JIT_PROFILE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(N64RspProfile)' == 'true'">
    <DefineConstants>$(DefineConstants);N64_RSP_PROFILE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(N64CpuDispatchProfile)' == 'true'">
    <DefineConstants>$(DefineConstants);N64_CPU_DISPATCH_PROFILE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(N64GpuBatchProfile)' == 'true'">
    <DefineConstants>$(DefineConstants);N64_GPU_BATCH_PROFILE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(N64LiveGpu)' == 'true'">
    <DefineConstants>$(DefineConstants);N64_LIVE_GPU</DefineConstants>
  </PropertyGroup>
  <!-- Diagnostic capture only: no observer fields or calls in shipping builds. -->
  <PropertyGroup Condition="'$(N64RdpJournalCapture)' == 'true'">
    <DefineConstants>$(DefineConstants);N64_RDP_JOURNAL</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'EutherDrive.Android'">
    <DisableWorkloadResolverRoot>$(MSBuildThisFileDirectory)</DisableWorkloadResolverRoot>
    <!-- point the resolver sentinel to a repo-local file and disable the resolver so we don't rely on /usr/share/dotnet permissions -->
    <__DisableWorkloadResolverSentinelPath>$(DisableWorkloadResolverRoot)workloadResolver.sentinel</__DisableWorkloadResolverSentinelPath>
    <MSBuildEnableWorkloadResolver>false</MSBuildEnableWorkloadResolver>
  </PropertyGroup>
</Project>
