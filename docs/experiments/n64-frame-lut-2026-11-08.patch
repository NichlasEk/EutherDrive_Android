+    private static class VideoColors
+    {
+        // Alpha is discarded by the opaque VI output. Keep the original floor
+        // scaling (v * 255 / 31), which differs from simple bit replication.
+        internal static readonly uint[] Bgra555 = Create();
+        private static uint[] Create()
+        {
+            var colors = new uint[32768];
+            for (int rgb = 0; rgb < colors.Length; rgb++)
+            {
+                uint b = (uint)((rgb & 31) * 255 / 31);
+                uint g = (uint)(((rgb >> 5) & 31) * 255 / 31);
+                uint r = (uint)(((rgb >> 10) & 31) * 255 / 31);
+                uint packed = 0xff000000u | (r << 16) | (g << 8) | b;
+                colors[rgb] = BitConverter.IsLittleEndian ? packed : BinaryPrimitives.ReverseEndianness(packed);
+            }
+            return colors;
+        }
+    }
