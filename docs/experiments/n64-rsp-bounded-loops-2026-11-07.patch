+        private int GetBlockInstructionLimit(uint start)
+        {
+            if (!BlockLoopsEnabled) return MaxBlockInstructions;
+            // Only extend a straight-line body ending in a direct backedge to
+            // its entry. Other code keeps the established 16-instruction limit.
+            for (int i = 0; i < 63 && start + (uint)(i + 1) * 4 < 4096; i++)
+            {
