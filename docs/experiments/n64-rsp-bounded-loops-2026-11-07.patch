+                if (IsBlockBranch(word))
+                {
+                    uint op = word >> 26;
+                    uint target = op <= 3 ? ((word & 0x03ffffff) << 2) & 0xffcu
+                        : BranchTarget(start + (uint)i * 4, unchecked((short)word));
+                    return op != 0 && target == start
+                        && IsBlockInstruction(_memory.ReadSpImemWord(start + (uint)(i + 1) * 4))
+                        ? i + 2 : MaxBlockInstructions;
+                }
+                if (!IsBlockInstruction(word)) break;
+            }
+            return MaxBlockInstructions;
+        }
