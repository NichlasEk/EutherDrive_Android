# Svensk Viking Skin
# Nationalromantik 2.0: kunglig heraldik, djup svart fond och svenskt guld/blatt
# Monumental, hogtidlig och mer fanborg an dashboard

[skin]
name = "Svensk Viking"
author = "EutherDrive"
version = "1.0"
description = "Nationalromantiskt Sverige-tema med heraldisk tyngd, djup fond, tretungade fanor och kungligt guld."

[colors]
# Djup svartbla bakgrund - mer kungasigill an modern app
background = "#060808"
background_soft = "#0E1416"
background_alt = "#040607"

# Paneler i heraldisk blect blatt
panel = "#112A45"
panel_raised = "#17385A"
panel_glass = "#CC112A45"
sub_panel = "#CC0C1E31"
option_card = "#D00E2338"

# Kantlinjer - gammalt guld och sval svensk blatt
stroke = "#7B6314"
stroke_bright = "#D6B23A"

# Text - varmt guld som i nationalromantiska affischer
text = "#F4D56A"
text_muted = "#B79A44"

# Accenter - riksguld och gammalemalj
accent = "#FECC00"
accent_warm = "#FFD768"
accent_hot = "#C96B2C"

[gradient.hero]
angle = 180
stop0 = "#17385A,0.0"
stop1 = "#0C2237,0.46"
stop2 = "#060808,1.0"

[gradient.screen_glow]
angle = 45
stop0 = "#44FECC00,0.0"
stop1 = "#12D6B23A,0.62"
stop2 = "#3317385A,1.0"

[typography]
# Run-liknande men hogtidligare stil pa rubriker
primary_font = "Cinzel, Noto Serif, Inter"
display_font = "Cinzel Decorative, Cinzel, Noto Serif, serif"
mono_font = "JetBrains Mono, Consolas, monospace"
deck_font = "Cinzel, Noto Serif, Inter"
base_size = 14
small_size = 11
display_size = 32
kicker_size = 12
deck_size = 17
letter_spacing = 0.8
deck_spacing = 2.1

[layout]
# Hogtidligare former - mindre mjuka, mer monumentala
border_radius = 6
border_radius_small = 3
border_radius_large = 14
border_radius_xlarge = 18
border_radius_full = 999
padding = 12
button_padding_x = 18
button_padding_y = 10
spacing = 8
spacing_small = 4
spacing_large = 14
shadow_opacity = 0.42
shadow_blur = 46
shadow_spread = 14

[buttons]
# Blatta knappar med forgyllt kantspel
background = "#13324F"
background_hover = "#1A4167"
background_pressed = "#0D2337"
background_action = "#1D4D7A"
background_action_hover = "#256195"
background_ghost = "#161B1E"

# Guldfattning och sma svartjarnsinslag
border = "#8B6D19"
border_hover = "#F4D56A"
border_ghost = "#6E6A58"

border_radius = 6
transition_duration = 0.2
hover_scale = 1.02
pressed_scale = 0.98

[panels]
# Tunga paneler med svagt lackad emaljkansla
glass_background = "#CC112A45"
glass_opacity = 0.88
subpanel_background = "#CC0C1E31"
subpanel_border = "#8B6D19"
optioncard_background = "#CC10263D"
optioncard_border = "#D6B23A"
border_radius = 14
subpanel_radius = 10
optioncard_radius = 6

[inputs]
# Blatta inputs med guldram
background = "#0A1A2A"
background_focus = "#10263D"
border = "#7B6314"
border_focus = "#F4D56A"
border_radius = 6
padding = 10

[effects]
use_transparency = true
use_blur = true
blur_radius = 15
use_glow = true
glow_color = "#FECC00"
glow_intensity = 0.24
use_animations = true
animation_speed = 0.9
use_background_effects = true
background_color_1 = "#17385A"
background_color_2 = "#D6B23A"
background_opacity = 0.1

[custom]
# Viking / nationalromantik
viking_mode = "true"
nordic_runes = "true"
flag_colors = "#006AA7,#FECC00"
scandinavian_design = "true"
emboss_texture = "true"
emboss_texture_opacity = "0.26"
emboss_texture_scale = "0.86"
emboss_texture_depth = "1.35"
emboss_texture_tint = "#11243A"
emboss_texture_highlight = "#D6B23A"
emboss_texture_shadow = "#020304"
relief_frames = "true"
relief_frames_opacity = "0.28"
relief_frames_scale = "0.82"
relief_frames_highlight = "#E3C15A"
relief_frames_shadow = "#040506"
