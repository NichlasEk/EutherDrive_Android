# Steel Fortress Skin
# Mork gunmetal med UE3-kansla, harda paneler och kalla highlights

[skin]
name = "Steel Fortress"
author = "EutherDrive"
version = "1.0"
description = "Morkt gunmetal-skin med kalla highlights, armor-plating och tung UE3-energi."

[colors]
background = "#06080B"
background_soft = "#0C1016"
background_alt = "#05070A"

panel = "#1A2027"
panel_raised = "#242D37"
panel_glass = "#D4192028"
sub_panel = "#CC121920"
option_card = "#D8162029"

stroke = "#465362"
stroke_bright = "#8FA9C3"

text = "#E2C66B"
text_muted = "#A58F4B"

accent = "#4E83B8"
accent_warm = "#E0B15E"
accent_hot = "#D96E6E"

[gradient.hero]
angle = 135
stop0 = "#2A3340,0.0"
stop1 = "#141A21,0.45"
stop2 = "#090C10,1.0"

[gradient.screen_glow]
angle = 30
stop0 = "#3369B6FF,0.0"
stop1 = "#114C96D8,0.6"
stop2 = "#22EAF6FF,1.0"

[typography]
primary_font = "Inter, Noto Sans"
display_font = "Cinzel, Inter, Noto Sans"
mono_font = "JetBrains Mono, Consolas, monospace"
deck_font = "Inter, Noto Sans"
base_size = 14
small_size = 11
display_size = 30
kicker_size = 11
deck_size = 15
letter_spacing = 0.5
deck_spacing = 1.4

[layout]
border_radius = 8
border_radius_small = 6
border_radius_large = 12
border_radius_xlarge = 16
border_radius_full = 999
padding = 11
button_padding_x = 15
button_padding_y = 9
spacing = 7
spacing_small = 4
spacing_large = 13
shadow_opacity = 0.34
shadow_blur = 36
shadow_spread = 8

[buttons]
background = "#2A3139"
background_hover = "#36404B"
background_pressed = "#1B2128"
background_action = "#486E96"
background_action_hover = "#5C87B5"
background_ghost = "#141A20"
border = "#74889C"
border_hover = "#DDEBFA"
border_ghost = "#495867"
border_radius = 8
transition_duration = 0.18
hover_scale = 1.015
pressed_scale = 0.988

[panels]
glass_background = "#D4161D24"
glass_opacity = 0.88
subpanel_background = "#CC11171D"
subpanel_border = "#667A8F"
optioncard_background = "#D8151C23"
optioncard_border = "#8399AE"
border_radius = 12
subpanel_radius = 10
optioncard_radius = 8

[inputs]
background = "#10151B"
background_focus = "#17202A"
border = "#617385"
border_focus = "#CFE4FA"
border_radius = 8
padding = 9

[effects]
use_transparency = true
use_blur = true
blur_radius = 14
use_glow = true
glow_color = "#9FC6EE"
glow_intensity = 0.12
use_animations = true
animation_speed = 0.9
use_background_effects = true
background_color_1 = "#253240"
background_color_2 = "#0F141A"
background_opacity = 0.2

[custom]
liquid_chrome = "true"
liquid_chrome_intensity = "0.88"
liquid_chrome_warp = "0.92"
liquid_chrome_bands = "7"
liquid_chrome_coolness = "0.42"
liquid_chrome_specular = "#BDD7F3"
liquid_chrome_shadow = "#020406"
metal_surface = "true"
metal_surface_gloss = "0.74"
metal_surface_contrast = "0.34"
metal_surface_specular = "#C5DCF2"
metal_surface_shadow = "#05080C"
metal_sheen = "true"
metal_sheen_opacity = "0.11"
metal_sheen_angle = "-18"
metal_sheen_band_thickness = "0.10"
metal_sheen_edge_opacity = "0.14"
metal_sheen_tint = "#AFC4D8"
metal_sheen_edge_tint = "#D5E7F7"
metal_rivets = "true"
metal_rivet_count = "7"
metal_rivet_radius = "4.2"
metal_rivet_inset = "16"
metal_rivet_opacity = "0.68"
metal_rivet_tint = "#8FA4B8"
