#version 450
#extension GL_ARB_gpu_shader_int64 : require
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=128) in;
layout(set=0,binding=0,std430) readonly buffer Input { uint data[]; };
layout(set=0,binding=1,std430) writeonly buffer Output { uint result[]; };
#include "sampling.glsl"
void main() {
    uint i=gl_GlobalInvocationID.x;
    if(i>=data[5]) return;
    uint p=8u+data[2]+data[3]+i*data[4];
    SampleState v=SampleState(data[p+8],data[p+13],data[p+12],data[p+16],data[p+17],data[p+14],
        int(data[p+9]),int(data[p+10]),int(data[p+11]));
    ivec4 c=sampleTexture(v,i64(p),i64(p+2),i64(p+4),packDouble2x32(uvec2(data[p+6],data[p+7])));
    // The expected RGBA at request word 15 is not read.
    result[i]=uint(c.r)|(uint(c.g)<<8)|(uint(c.b)<<16)|(uint(c.a)<<24);
}
